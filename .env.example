# Sao chép thành .env và điền giá trị thật (không commit .env)
APP_DB=postgresql

# Neon / cloud (ưu tiên) — dán connection string từ Neon Console
APP_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Hoặc PostgreSQL local (khi không dùng APP_DATABASE_URL)
# APP_POSTGRES_HOST=localhost
# APP_POSTGRES_PORT=5432
# APP_POSTGRES_DATABASE=meeting_room_db
# APP_POSTGRES_USER=postgres
# APP_POSTGRES_PASSWORD=

APP_JWT_SECRET=change-me-in-production
APP_JWT_EXPIRE_MINUTES=240
APP_JWT_REMEMBER_EXPIRE_MINUTES=43200

APP_PUBLIC_URL=http://127.0.0.1:8000
APP_SHOW_RESET_LINK=true
APP_RESET_TOKEN_EXPIRE_MINUTES=60
