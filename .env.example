# Sao chép thành .env và điền giá trị thật (không commit .env)
APP_DB=postgresql
APP_DATABASE_URL=postgresql://user:password@localhost:5432/meeting_room

APP_JWT_SECRET=change-me-in-production
APP_JWT_EXPIRE_MINUTES=240
APP_JWT_REMEMBER_EXPIRE_MINUTES=43200

APP_PUBLIC_URL=http://127.0.0.1:8000
APP_SHOW_RESET_LINK=true
APP_RESET_TOKEN_EXPIRE_MINUTES=60
